# ==============================================================================
# CHARLEES HOTEL & SUITES — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development, and add these variables
# in Vercel Project Settings -> Environment Variables for production.
# Never expose server-only keys with the NEXT_PUBLIC_ prefix.

# --- Application URL ---
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase (Authoritative Database, Auth & Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Staff Session Signing (Optional override; falls back to runtime secret in preview) ---
AUTH_SESSION_SECRET=
ADMIN_BOOTSTRAP_PASSCODE=

# --- Payment Provider (Paystack Nigeria - Server Side Verification) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Email Notifications (Resend / SMTP) ---
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="reservations@charleeshotel.com"

# --- Google Drive Media Integration (Optional Server or OAuth Sync) ---
GOOGLE_DRIVE_FOLDER_ID=

# --- Analytics & Search Console ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# --- Gemini API (AI Studio Runtime) ---
GEMINI_API_KEY=
